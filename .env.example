APP_ENV=dev
APP_VERSION=0.1.0
DATABASE_URL=postgresql+psycopg://dataops:dataops@localhost:5432/dataops
INGEST_API_KEY=change-me
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me
LLM_PROVIDER=anthropic          # anthropic | fake
LLM_MODEL=claude-haiku-4-5      # pick a current, inexpensive model
ANTHROPIC_API_KEY=
EMBEDDINGS_PROVIDER=tfidf       # tfidf | fastembed
FEATURE_COPILOT=true
FEATURE_RISK_MODEL=true
